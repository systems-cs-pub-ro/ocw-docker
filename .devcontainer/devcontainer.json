{
  "name": "ocw-dokuwiki",
  "context": "..",
  "dockerFile": "../Dockerfile",
  "containerUser": "app",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "DokuWiki", "onAutoForward": "notify" }
  },
  "mounts": [
    "source=dokuwiki-storage,target=/storage,type=volume"
  ],
  "containerEnv": {
    "PHP_TIMEZONE": "Europe/Bucharest",
    "DOKUWIKI_ADMIN_USER": "admin",
    "DOKUWIKI_ADMIN_PASSWORD": "admin123"
  }
}
