# Rewrite /courses/* to farm animals

# /courses/ would redirect to /courses/start, so workaround it:
RewriteRule ^(courses)/$             $1 [QSA,DPI]
RewriteRule ^courses/(lib|lib/.*|_media.*|_export.*|doku.php)$ $1 [QSA,DPI]

# animals will use their IDs also as first namespace
RewriteRule ^courses/([^/]+)/?$     $1?animal=$1 [QSA,DPI]
RewriteRule ^courses/([^/]+)/(lib|lib/.*|_media.*|_export.*|doku.php)$ $2?animal=$1 [QSA,DPI]
RewriteRule ^courses/([^/]+)/(.*)    $1/$2?animal=$1 [QSA,DPI]

